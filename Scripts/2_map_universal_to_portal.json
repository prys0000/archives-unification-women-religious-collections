{
  "input_sheet": null,
  "xml_sheet": "ContainerList",
  "constants": { "Contributing Hub": "HARC" },
  "portal_rules": {
    "Identifier": { "source": "", "transforms": ["strip"] },
    "Contributing Hub": { "source": "__CONST__", "transforms": ["strip"] },

    "Title": { "source": "title", "transforms": ["strip", "collapse_ws"] },

    "Date span (indexed)": { "source": "", "transforms": ["strip"] },
    "Date (display)": { "source": "", "transforms": ["strip"] },
    "Dates (religious: entrance, first vows, etc.)": { "source": "", "transforms": ["strip"] },

    "Creator(s)": { "source": "", "transforms": ["strip"] },
    "Rights (NAPWR Access)": { "source": "", "transforms": ["strip"] },
    "Language": { "source": "", "transforms": ["strip"] },

    "Women Religious Archival Genre (Record type)": { "source": "", "transforms": ["strip"] },
    "Carrier / technical format": { "source": "", "transforms": ["strip"] },

    "Collection title": { "source": "title", "transforms": ["strip", "collapse_ws"] },
    "Landing page (hub record URL)": { "source": "", "transforms": ["strip"] },

	"Abstract / scope and contents": {
	  "source_any_of": [
		"Description.1",
		"Description",
		"Scope and Contents",
		"Scope & Contents",
		"Summary",
		"Abstract",
		"Notes"
	  ],
	  "transforms": ["strip", "collapse_ws"]
	}

,

    "Subject(s) (Topical Subject)": { "source": "", "transforms": ["strip", "dedupe_semicolon_list"] },
    "Mission(s) [Ministry Domain]": { "source": "", "transforms": ["strip"] },
    "Location(s) represented": { "source": "", "transforms": ["strip"] },
    "Physical Location": { "source": "", "transforms": ["strip"] },

    "Type": { "source": "type", "transforms": ["strip"] },
    "Extent": { "source": "extent", "transforms": ["strip"] },

    "Thumbnail": { "source": "", "transforms": ["strip"] },
    "Web_view": { "source": "", "transforms": ["strip"] },
    "Available at": { "source": "", "transforms": ["strip"] }
  },

	"enrich": {
	  "date_source_any_of": ["Dates", "Date", "dates"],
	  "title_source_any_of": ["title", "Title"],
	  "text_cols_for_enrichment": [
		"title", "Title",
		"Description2", "Description1",
		"Description", "Scope and Contents", "Scope & Contents", "Summary", "Abstract", "Notes",
		"Key words/Subjects"
	  ],
	  "append_enrichment_cols": true
	}


}
